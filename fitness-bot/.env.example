# ==============================================================================
# Telegram Bot "Личный тренер" - Configuration
# ==============================================================================
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# TELEGRAM BOT (обязательно)
# ------------------------------------------------------------------------------
# Получите токен у @BotFather в Telegram
BOT_TOKEN=your_bot_token_here

# ID администраторов бота (через запятую). Пример: [123456789, 987654321]
BOT_ADMIN_IDS=[]

# ------------------------------------------------------------------------------
# DATABASE (обязательно)
# ------------------------------------------------------------------------------
# SQLite (для разработки):
DATABASE_URL=sqlite+aiosqlite:///./fitness_bot.db

# PostgreSQL (для production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fitness_bot

# ------------------------------------------------------------------------------
# REDIS (рекомендуется для production)
# ------------------------------------------------------------------------------
# Redis используется для:
# - Хранения FSM состояний (сохраняются при перезапуске)
# - Кэширования данных
# - Rate limiting
#
# Если REDIS_URL не указан, используется MemoryStorage (данные теряются при перезапуске)

# Локальный Redis:
# REDIS_URL=redis://localhost:6379/0

# Redis с паролем:
# REDIS_URL=redis://:password@localhost:6379/0

# Redis Cloud / Managed:
# REDIS_URL=rediss://user:password@host:6379/0

# Оставьте закомментированным для разработки без Redis:
# REDIS_URL=

# ------------------------------------------------------------------------------
# MONITORING (рекомендуется для production)
# ------------------------------------------------------------------------------
# Sentry - мониторинг ошибок (https://sentry.io)
# Создайте проект на sentry.io и получите DSN
#
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Среда для Sentry (development, staging, production)
SENTRY_ENVIRONMENT=development

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# Режим отладки (True - подробные логи, False - production)
DEBUG=True

# Часовой пояс для напоминаний
TIMEZONE=Europe/Moscow

# ------------------------------------------------------------------------------
# OPTIONAL FEATURES
# ------------------------------------------------------------------------------
# Open Food Facts API (включен по умолчанию, без ключа)
# OFF_ENABLED=true

# Минимальный интервал между запросами пользователя (секунды)
# RATE_LIMIT_INTERVAL=0.5

# Максимум запросов в минуту от одного пользователя
# RATE_LIMIT_MAX_PER_MINUTE=30
